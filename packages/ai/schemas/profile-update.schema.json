{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moxu.local/schemas/profile-update.schema.json",
  "title": "Profile update proposals",
  "type": "object",
  "additionalProperties": false,
  "required": ["proposals"],
  "properties": {
    "proposals": {
      "type": "array", "maxItems": 6,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["type", "label", "description", "evidenceLevel", "sourceIds", "relation", "existingEntryId", "confirmationQuestion"],
        "properties": {
          "type": { "enum": ["skill", "interest", "trying", "collaboration_preference", "conversation_preference"] },
          "label": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "evidenceLevel": { "enum": ["explicit", "demonstrated", "tentative"] },
          "sourceIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "relation": { "enum": ["new", "update_existing", "add_source"] },
          "existingEntryId": { "type": ["string", "null"] },
          "confirmationQuestion": { "type": "string" }
        }
      }
    }
  }
}
